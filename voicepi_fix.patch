+
+  snapshot_on_turn: true
+  always_attach_to_prompt: false
+  max_prompt_age_s: 8.0
+
+  log_poll_observations: false
+  obstacle_area_ratio: 0.10
+
+  motion:
+    enabled: true
+    threshold: 24
+    min_area_ratio: 0.01
+
+  object_detection:
+    enabled: true
+    # "yolo"   -- YOLOv11n via ONNX Runtime (no PyTorch). Best accuracy on COCO 80 classes.
