+  # "kokoro" -- Kokoro 82M via ONNX Runtime (excellent offline quality, ~400 MB models)
+  # "piper"  -- Piper (fastest, lower quality)
+  engine: "edge"
+
+  normalize_text: true
+  stream_during_generation: true   # start playback of first sentence while rest is synthesizing
+
+  sentence_min_chars: 25    # shorter first chunk = faster first audio
+  sentence_max_chars: 200   # keeps chunks manageable on Pi CPU
+  chunk_max_chars: 280
+  coalesce_wait_s: 0.03
+
+  synth_timeout_s: 35
+  join_timeout_s: 45
+  playback_gap_ms: 120
+
+  # --- Edge TTS config (engine: "edge") ---
+  # Best quality voices: en-US-AriaNeural, en-US-JennyNeural, en-US-GuyNeural,
+  #   en-GB-SoniaNeural, en-GB-RyanNeural, en-AU-NatashaNeural
+  edge:
+    voice: "en-US-AriaNeural"
+    rate: "+0%"       # e.g. "+10%" to speak faster
+    volume: "+0%"
+
+  # --- Kokoro ONNX config (engine: "kokoro") ---
+  # Voices: af_heart (default), af_bella, af_nicole, am_adam, am_michael,
+  #   bf_emma, bf_isabella, bm_george, bm_lewis
+  # Download models first: python scripts/download_models.py --tts-engine kokoro
+  kokoro:
+    voice: "af_heart"
+    speed: 1.0
+    lang: "en-us"   # "en-us" or "en-gb"
+    sample_rate: 24000
+    warmup: true      # synthesize dummy phrase at boot to avoid cold-start delay
+    model_path: "models/kokoro/kokoro-v1.0.int8.onnx"
+    voices_path: "models/kokoro/voices-v1.0.bin"
+
+  # --- Piper config (engine: "piper") ---
+  piper_bin: "piper"
+  model_path: "models/piper/en_US-amy-medium.onnx"
+  config_path: "models/piper/en_US-amy-medium.onnx.json"
+  speaker_id: null
+  length_scale: 1.12
+  noise_scale: 0.45
+  noise_w: 0.55
+  sentence_silence: 0.28
+
+memory:
+  enabled: true
+  db_path: "logs/memory.sqlite"
+  user_id: "default"
+  attach_to_prompt: true
+
+  max_facts: 5
+  recall_k: 2
+
+  extract_facts: true
+  max_episodes: 2000
+
